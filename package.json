{
  "name": "react-spaghetti",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "A visual IDE designed to create React Components using a unified layout tree and logic graph",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "react",
    "ide",
    "visual-editor",
    "low-code",
    "drag-and-drop",
    "node-editor"
  ],
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "author": "",
  "license": "MIT"
}
